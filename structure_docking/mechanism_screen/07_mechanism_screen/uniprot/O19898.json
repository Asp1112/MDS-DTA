    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000250"
            }
          ],
          "value": "Catalyzes the transfer of endogenously produced octanoic acid from octanoyl-acyl-carrier-protein onto the lipoyl domains of lipoate-dependent enzymes. Lipoyl-ACP can also act as a substrate although octanoyl-ACP is likely to be the physiological substrate (By similarity)"
        }
      ],
      "commentType": "FUNCTION"
    },
    {
      "commentType": "CATALYTIC ACTIVITY",
